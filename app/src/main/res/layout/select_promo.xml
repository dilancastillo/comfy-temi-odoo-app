<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ICONO REGRESAR -->
    <ImageView
        android:id="@+id/imgbtnback"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:src="@drawable/regresar"
        android:contentDescription="Regresar"
        android:clickable="true"
        android:focusable="true"
        android:tint="@color/primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"/>
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="650dp"
        android:layout_height="220dp"
        android:src="@drawable/logo_comfer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tituloMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="¡Las mejores ofertas están aquí!"
        android:textSize="40sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@color/primary"
        android:background="@color/primary_dark"
        app:layout_constraintTop_toBottomOf="@id/imgLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="0dp"/>

    <TextView
        android:id="@+id/subtituloMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Selecciona una opción y aprovecha nuestras grandes promociones"
        android:textSize="31sp"
        android:gravity="center"
        android:textColor="@color/white"
        android:background="@color/primary_dark"
        app:layout_constraintTop_toBottomOf="@id/tituloMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="0dp"
        android:paddingBottom="3dp"/>

    <GridLayout
        android:id="@+id/cardGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true"
        app:layout_constraintTop_toBottomOf="@id/subtituloMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/icon_washbasinpromo"
            android:layout_width="0dp"
            android:layout_height="350dp"
            android:layout_columnWeight="1"
            android:foreground="?attr/selectableItemBackground"
            app:strokeColor="@android:color/transparent"
            app:cardBackgroundColor="@android:color/transparent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/coupon"
                    android:scaleType="fitXY" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="left|center"
                    android:paddingStart="220dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LAVAMANOS"
                        android:textSize="30sp"
                        android:textColor="#000000"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="50dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hasta 28,6%"
                        android:textSize="42sp"
                        android:textColor="#000000"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En lavamanos seleccionados"
                        android:textSize="20sp"
                        android:textColor="#000000"
                        android:layout_marginTop="8dp" />

                    <Button
                        android:id="@+id/tbnicon_washbasinpromo"
                        android:layout_width="130dp"
                        android:layout_height="50dp"
                        android:text="Ir"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/button_bg_selector"
                        android:textColor="@color/text_promo_selector"
                        app:cornerRadius="25dp"
                        android:textSize="22dp"/>

                </LinearLayout>

            </FrameLayout>


        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/floortilepromo"
            android:layout_width="0dp"
            android:layout_height="350dp"
            android:layout_columnWeight="1"
            android:foreground="?attr/selectableItemBackground"
            app:strokeColor="@android:color/transparent"
            app:cardBackgroundColor="@android:color/transparent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/coupon2"
                    android:scaleType="fitXY" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="left|center"
                    android:paddingStart="220dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REVESTIMIENTOS"
                        android:textSize="30sp"
                        android:textColor="#000000"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="50dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hasta 24,3%"
                        android:textSize="42sp"
                        android:textColor="#000000"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En revestimientos seleccionados"
                        android:textSize="20sp"
                        android:textColor="#000000"
                        android:layout_marginTop="8dp" />

                    <Button
                        android:id="@+id/btnfloortilepromo"
                        android:layout_width="130dp"
                        android:layout_height="50dp"
                        android:text="Ir"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/button_bg_selector"
                        android:textColor="@color/text_promo_selector"
                        app:cornerRadius="20dp"
                        android:textSize="22dp"/>

                </LinearLayout>

            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/kitchenpromo"
            android:layout_width="0dp"
            android:layout_height="350dp"
            android:layout_columnWeight="1"
            android:foreground="?attr/selectableItemBackground"
            app:strokeColor="@android:color/transparent"
            app:cardBackgroundColor="@android:color/transparent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/coupon3"
                    android:scaleType="fitXY" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="left|center"
                    android:paddingStart="220dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COCINA"
                        android:textSize="30sp"
                        android:textColor="#000000"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="50dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hasta 28,6%"
                        android:textSize="42sp"
                        android:textColor="#000000"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="20sp"
                        android:textColor="#000000"
                        android:layout_marginTop="8dp" />

                    <Button
                        android:id="@+id/btnkitchenpromo"
                        android:layout_width="130dp"
                        android:layout_height="50dp"
                        android:text="Ir"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/button_bg_selector"
                        android:textColor="@color/text_promo_selector"
                        app:cornerRadius="20dp"
                        android:textSize="22dp"/>

                </LinearLayout>

            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

    </GridLayout>
    <TextView
        android:id="@+id/textTyc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Aplica Términos y Condiciones."
        android:textSize="20sp"
        android:gravity="center"
        android:textColor="@color/primary_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>