<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ICONO REGRESAR -->
    <ImageView
        android:id="@+id/imgbtnback"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:src="@drawable/regresar"
        android:contentDescription="Regresar"
        android:clickable="true"
        android:focusable="true"
        android:tint="@color/primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"/>

    <!-- TÍTULO -->
    <TextView
        android:id="@+id/tituloMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Promociones"
        android:textSize="34sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/imgbtnback"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- SUBTÍTULO -->
    <TextView
        android:id="@+id/subtituloMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Selecciona una opción y gana una promoción"
        android:textSize="25sp"
        android:gravity="center"
        android:textColor="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/tituloMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"/>

    <!-- GRID DE 3 COLUMNAS -->
    <GridLayout
        android:id="@+id/cardGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/subtituloMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- CARD 1 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnfloortilepromo"
            android:layout_width="0dp"
            android:layout_height="380dp"
            android:layout_columnWeight="1"
            android:layout_margin="12dp"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="14dp"
            app:cardElevation="5dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/card_bg_selector">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <View
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center_horizontal"
                    android:src="@drawable/icon_floortilepromo"
                    app:tint="@color/icon_content_selector"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_horizontal"
                    android:text="Promoción en Revestimientos"
                    android:textSize="30sp"
                    android:textColor="@color/text_content_selector"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD 2 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnkitchenpromo"
            android:layout_width="0dp"
            android:layout_height="380dp"
            android:layout_columnWeight="1"
            android:layout_margin="12dp"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="14dp"
            app:cardElevation="5dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/card_bg_selector">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <View
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center_horizontal"
                    android:src="@drawable/icon_kitchenpromo"
                    app:tint="@color/icon_content_selector"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_horizontal"
                    android:text="Pomoción en cocina"
                    android:textSize="30sp"
                    android:textColor="@color/text_content_selector"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD 3 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tbnicon_washbasinpromo"
            android:layout_width="0dp"
            android:layout_height="380dp"
            android:layout_columnWeight="1"
            android:layout_margin="12dp"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="14dp"
            app:cardElevation="5dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/card_bg_selector">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <View
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center_horizontal"
                    android:src="@drawable/icon_washbasinpromo"
                    app:tint="@color/icon_content_selector"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_horizontal"
                    android:text="Promoción en lavamanos"
                    android:textSize="30sp"
                    android:textColor="@color/text_content_selector"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>