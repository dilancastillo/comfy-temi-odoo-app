<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    tools:context=".SpinnerActivity">

    <ImageView
        android:id="@+id/imgWheel"
        android:layout_width="755dp"
        android:layout_height="755dp"
        android:src="@drawable/img_wheel"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Marco con flecha (fijo) -->
    <ImageView
        android:id="@+id/imgFrame"
        android:layout_width="780dp"
        android:layout_height="780dp"
        android:src="@drawable/img_frame"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="@id/imgWheel"
        app:layout_constraintBottom_toBottomOf="@id/imgWheel"
        app:layout_constraintStart_toStartOf="@id/imgWheel"
        app:layout_constraintEnd_toEndOf="@id/imgWheel"/>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieConfetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:lottie_fileName="winner.json"
        app:lottie_loop="false"
        app:lottie_autoPlay="false"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvPrize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GANASTE 20% DE DESCUENTO"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:visibility="gone"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- Botón girar -->
    <Button
        android:id="@+id/btnSpin"
        android:layout_width="300dp"
        android:layout_height="70dp"
        android:text="GIRAR"
        android:textSize="25dp"
        app:layout_constraintTop_toBottomOf="@id/imgFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="14dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>